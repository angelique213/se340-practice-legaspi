<!-- Header partial -->
<%- include('../partials/header') %>

<main>

    <!-- Page title -->
    <h1><%= title %></h1>

    <!-- Page description -->
    <p>
        Browse faculty members below.
    </p>

    <!-- Sorting options -->
    <p>
        Sort by:
        <a href="/faculty?sort=name">Name</a> |
        <a href="/faculty?sort=department">Department</a> |
        <a href="/faculty?sort=title">Title</a>
    </p>

    <!-- Faculty cards container -->
    <div class="catalog-container">

        <!-- Loop through all faculty members -->
        <% faculty.forEach(member => { %>

            <div class="course-card">

                <!-- Faculty name with detail page link -->
                <h2>
                    <a href="/faculty/<%= member.slug %>">
                        <%= member.name %>
                    </a>
                </h2>

                <!-- Faculty department -->
                <p>
                    <strong>Department:</strong>
                    <%= member.department %>
                </p>

                <!-- Faculty title -->
                <p>
                    <strong>Title:</strong>
                    <%= member.title %>
                </p>

            </div>

        <% }) %>

    </div>
</main>

<!-- Footer partial -->
<%- include('../partials/footer') %>