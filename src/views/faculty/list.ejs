<%- include('../partials/header') %>

<main>
    <h1><%= title %></h1>

    <p>
        Browse faculty members below.
    </p>

    <!-- Sorting links -->
    <p>
        Sort by:
        <a href="/faculty?sort=name">Name</a> |
        <a href="/faculty?sort=department">Department</a> |
        <a href="/faculty?sort=title">Title</a>
    </p>

    <div class="catalog-container">

        <% faculty.forEach(member => { %>

            <div class="course-card faculty-card">

                <!-- Faculty profile image -->
                <img
                    class="faculty-photo"
                    src="/images/faculty/<%= member.slug %>.jpg"
                    alt="Photo of <%= member.name %>"
                >

                <h2>
                    <a href="/faculty/<%= member.slug %>">
                        <%= member.name %>
                    </a>
                </h2>

                <p><strong>Department:</strong> <%= member.department %></p>
                <p><strong>Title:</strong> <%= member.title %></p>

            </div>

        <% }) %>

    </div>
</main>

<%- include('../partials/footer') %>